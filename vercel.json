{
    "version": 2,
    "functions": {
        "index.js": {
            "memory": 1024,
            "maxDuration": 60
        },
        "api/chat.js": {
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/chat",
            "destination": "/api/chat.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.js"
        }
    ]
}